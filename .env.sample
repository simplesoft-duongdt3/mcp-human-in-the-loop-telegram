# Copy or rename this file to .env and fill in your credentials below

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=*REPLACE**:*REPLACE***************************

# Your Telegram User ID (optional - bot will auto-detect if not set)
# You can find this by messaging @userinfobot on Telegram
# TELEGRAM_USER_ID=*REPLACE**

# Optional: Default behavior for ask_human tool
# Set to 'true' for blocking mode (waits for response) or 'false' for non-blocking
# DEFAULT_WAIT_MODE=true

# Optional: Default timeout in seconds for blocking mode
DEFAULT_TIMEOUT_SECONDS=180
